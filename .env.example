# Copy to ".env" and fill in. Do not commit ".env".

# ── Primary LLM provider ───────────────────────────────────────────────────
# Options: groq | cerebras | together | openai | ollama
LLM_PROVIDER=groq
# Fallback: tried automatically if Groq exhausts retries (rate limit / outage)
LLM_FALLBACK_PROVIDER=cerebras

# Groq — fast free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — fastest inference, free tier: https://inference.cerebras.ai/
CEREBRAS_API_KEY=
# Cerebras model names (dash format required):
# LLM_FLASH_CEREBRAS=llama-3.1-8b
# LLM_PRO_CEREBRAS=llama-3.3-70b

# Together AI — https://api.together.xyz
# TOGETHER_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Optional: override default models (see Groq model list in console docs)
# LLM_FLASH=llama-3.1-8b-instant
# LLM_PRO=llama-3.3-70b-versatile

# GPU acceleration — set to "true" to force GPU, "false" to force CPU, "auto" to detect
# USE_GPU=auto

# MongoDB
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=automl_system
EPISODIC_COLLECTION=episodic_memory
SEMANTIC_COLLECTION=semantic_memory

# Optional: limits and timeouts (defaults shown in config.py)
# MAX_ITERATIONS=3
# MAX_FILE_SIZE_MB=50
# MONGODB_CONNECT_TIMEOUT_MS=5000
