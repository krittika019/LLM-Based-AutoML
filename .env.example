# Copy to ".env" and fill in. Do not commit ".env".

# ── Primary LLM provider ───────────────────────────────────────────────────
# Options: groq | cerebras | together | openai | ollama
LLM_PROVIDER=groq
# Fallback: tried automatically if Groq exhausts retries (rate limit / outage)
LLM_FALLBACK_PROVIDER=cerebras

# Groq — fast free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — fastest inference, free tier: https://inference.cerebras.ai/
CEREBRAS_API_KEY=
# Cerebras model names (dash format required):
# LLM_FLASH_CEREBRAS=llama-3.1-8b
# LLM_PRO_CEREBRAS=llama-3.3-70b

# Together AI — https://api.together.xyz
# TOGETHER_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Optional: override default models (see Groq model list in console docs)
# LLM_FLASH=llama-3.1-8b-instant
# LLM_PRO=llama-3.3-70b-versatile

# GPU acceleration — set to "true" to force GPU, "false" to force CPU, "auto" to detect
# USE_GPU=auto

# MongoDB
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=automl_system
EPISODIC_COLLECTION=episodic_memory
SEMANTIC_COLLECTION=semantic_memory

# Optional: limits and timeouts (defaults shown in config.py)
# MAX_ITERATIONS=3
# MAX_FILE_SIZE_MB=50
# MONGODB_CONNECT_TIMEOUT_MS=5000

# Sandbox for executing generated code — build the image first:
#   docker build -t automl-sandbox:1 ./sandbox
# auto = Docker if available, else local subprocess | docker | local | off
# SANDBOX_BACKEND=auto
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2
# SANDBOX_TIMEOUT_SEC=300


# Phase 7: the final script is run in the sandbox and must reproduce the reported
# test score; failures are sent back to the LLM for repair (up to N times).
# SCRIPT_VALIDATION_MAX_REPAIRS=3
# SCRIPT_VALIDATION_TOLERANCE=0.02       # absolute gap for accuracy/F1/R²/AUC
# SCRIPT_VALIDATION_REL_TOLERANCE=0.05   # relative gap for RMSE/MAE

# Web app: also train AutoGluon/FLAML inside every run for comparison
# (slow — adds ~2× AUTOML_BENCHMARK_TIME_LIMIT). experiments/benchmark.py ignores this.
# APP_RUN_COMPETITORS=false

# Feature engineering: cv = keep an LLM-proposed feature only if it improves the
# cross-validated score of a fast LightGBM proxy (original-scale columns);
# corr = older correlation filter on cleaned/encoded columns.
# FE_SELECTION=cv
# FE_ROUNDS=2            # propose → measure → feed results back → propose again
# FE_MIN_CV_GAIN=0.0005  # minimum mean CV gain (ROC-AUC or R²) to keep a feature
# LLM-written feature functions (group stats, frequencies, binning, text), run ONLY in the
# Docker sandbox and kept only if they pass the same CV gate. auto = on when Docker is up.
# FE_CODE_FEATURES=off   # set to auto to enable (needs the Docker sandbox)
# FE_CODE_TIMEOUT_SEC=120

# Start Docker Desktop only when a run reaches script verification, and stop it again
# afterwards (only if the app started it) — its VM holds 1-3 GB of RAM even when idle.
# SANDBOX_DOCKER_ON_DEMAND=true
# SANDBOX_DOCKER_BOOT_TIMEOUT_SEC=120
