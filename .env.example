# Copy to ".env" and fill in. Do not commit ".env".

# Groq — create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override default models (see Groq model list in console docs)
# LLM_FLASH=llama-3.1-8b-instant
# LLM_PRO=llama-3.3-70b-versatile

# MongoDB
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=automl_system
EPISODIC_COLLECTION=episodic_memory
SEMANTIC_COLLECTION=semantic_memory

# Optional: limits and timeouts (defaults shown in config.py)
# MAX_ITERATIONS=3
# MAX_FILE_SIZE_MB=50
# MONGODB_CONNECT_TIMEOUT_MS=5000
